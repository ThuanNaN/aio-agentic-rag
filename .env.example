# ─────────────────────────────────────────────────────────────────────────────
# Chroma vector store (required)
# ─────────────────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost   # use "chroma" when running inside Docker network
CHROMA_PORT=8000        # host-mapped port (docker-compose: 8000→8000 for chroma, api on 8001→8000); use 8000 inside Docker
CHROMA_UBS=512          # Upsert batch size (chunks per Chroma call)

# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider — pick ONE block, delete or comment out the others
# ─────────────────────────────────────────────────────────────────────────────

# ── Option 1: OpenAI ──────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini          # gpt-4o | gpt-4.1 | gpt-4o-mini
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=              # leave blank for api.openai.com

# ── Option 2: OpenRouter (access 200+ models via one API key) ─────────────────
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini  # or meta-llama/llama-3.1-70b-instruct, etc.
# OPENROUTER_API_KEY=sk-or-...

# ── Option 3: OpenAI-Compatible (vLLM on GPU machine) ────────────────────────
# LLM_PROVIDER=vllm
# LLM_MODEL=your-model-name      # model name as served by vLLM
# VLLM_BASE_URL=http://gpu-host:8000/v1
# VLLM_API_KEY=empty

# ── Option 4: Google Gemini ───────────────────────────────────────────────────
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash    # gemini-1.5-pro | gemini-2.0-flash
# GOOGLE_API_KEY=AIza...

# ─────────────────────────────────────────────────────────────────────────────
# Optional: generation temperature (default 0.0 for deterministic answers)
# LLM_TEMPERATURE=0.0

# ─────────────────────────────────────────────────────────────────────────────
# Embeddings — vLLM server on GPU machine (OpenAI-compatible /v1/embeddings)
# Start server: vllm serve google/embeddinggemma-300m --port 8080
# ─────────────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=google/embeddinggemma-300m
EMBEDDING_BASE_URL=http://localhost:8080/v1
EMBEDDING_API_KEY=empty
EMBEDDING_BATCH_SIZE=512     # texts per HTTP request to vLLM
EMBEDDING_WORKERS=16         # concurrent embedding requests during ingestion

# ─────────────────────────────────────────────────────────────────────────────
# HuggingFace (required for dataset download)
# ─────────────────────────────────────────────────────────────────────────────
HF_TOKEN=hf_...
